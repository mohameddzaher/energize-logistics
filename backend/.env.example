# MongoDB
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?appName=yourApp
# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Seed Admin
SEED_ADMIN_EMAIL=admin@energize.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin

# UPL / Operations external system (B2B: Fleet Management + 3PL)
UPL_BASE_URL=https://backend.energize-logistics.com
UPL_API_KEY=your-upl-x-api-key
UPL_ADMIN_EMAIL=admin@admin.com
UPL_ADMIN_PASSWORD=your-upl-admin-password
# Near-real-time polling (ms): shipments (fast) + stats (slower)
UPL_POLL_INTERVAL_MS=6000
UPL_STATS_INTERVAL_MS=30000
# Shared secret for inbound UPL webhook (POST /api/ops/webhook) for instant push
UPL_WEBHOOK_SECRET=change-me
# How often (minutes) to mirror UPL customers into the CRM
OPS_CUSTOMER_SYNC_MIN=30
# Safety-net full reconciliation for UPL shipments → Operations workflow (live updates come from the poll within ~6s)
UPL_WORKFLOW_SYNC_MIN=60

# Location Solutions (Wialon) GPS/telemetry integration — قسم لوكيشن سوليوشن
# Endpoint is /wialon/ajax.html (NOT /lsx). Auth is token → session.
LS2_BASE_URL=https://ls2a.locationsolutions.com/wialon/ajax.html
LS2_TOKEN=your-72-char-location-solutions-access-token
LS2_POLL_INTERVAL_MS=20000
