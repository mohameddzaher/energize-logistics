# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build
dist/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# النسخ الاحتياطية المؤرَّخة أيضًا: نسخةٌ منها وصلت المستودع العامّ ومعها مفاتيح
# توقيع الجلسات المستعمَلة في الإنتاج، فبقيت مقروءةً للجميع حتى اكتُشفت.
.env
.env.*
!.env.example
.env.local
.env.production
.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code
.claude/

# HR import data (contains PII — never commit)
src/scripts/master_data.json
backend/src/scripts/master_data.json
backend/src/scripts/hr-sheet.json

# CRM vendor seed data (contains real vendor phone numbers — PII)
backend/src/seeds/data/

# uploaded employee documents (local disk storage)
backend/uploads/

# Local infra/ops reference — sensitive, never commit
INFRASTRUCTURE.md

# Employee/customs master spreadsheets — contain PII (IBANs, national IDs). Kept local + on the server only.
backend/src/data/masters/

# نسخ إعادة بناء الموارد البشرية — فيها بيانات موظفين، تفضل محليًا
backend/backups/

# جداول العمل الخام في جذر المشروع — بياناتُ شركةٍ حقيقية، والمستودع عامّ.
# نسخُها العاملة تحت backend/src/seeds/data/ وهي مستثناةٌ أصلًا.
/*.xlsx
/~$*.xlsx

# سكربتات فحصٍ عابرة — تُكتب لسؤالٍ واحد ثم تُحذف، ولا مكان لها في المستودع.
backend/_*.js

# تقارير تُكتب لتُرسَل، لا لتُخزَّن في المستودع.
/تقرير*.txt
